# ============================================
# Karyawan AI — Environment Variables
# ============================================
# Copy file ini menjadi .env dan isi dengan value yang benar
# JANGAN commit file .env ke Git!

# Google Gemini API Key
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database
DATABASE_URL=postgresql://karyawan:karyawan_secret_2026@postgres:5432/karyawan_ai

# Redis (Message Broker untuk Celery)
REDIS_URL=redis://redis:6379/0

# Secret Key (ganti dengan string random yang panjang)
SECRET_KEY=ganti-dengan-kunci-rahasia-yang-panjang

# Server Management (SSH)
SERVER1_IP=103.131.51.163
SERVER1_PORT=55714
SERVER2_IP=103.131.51.163
SERVER2_PORT=55714

# Database Server 1 (Untuk Login)
TIMESHEET_DB_URL=postgresql://ParkerRussellAIK:YOUR_PASSWORD@103.131.51.167:8896/streamsheetdb
